--==================================================
-- ESTADO
--==================================================

local isSizeOn = false
local currentCharacter = nil

local normalScale = 1
local scalingMode = "Model"

local originalR15Scales = nil
local originalAutomaticScaling = nil

--==================================================
-- OBTENER PERSONAJE
--==================================================

local function getCharacter()
	local character = player.Character

	if not character or not character.Parent then
		character = player.CharacterAdded:Wait()
	end

	local humanoid = character:WaitForChild("Humanoid", 5)

	if not humanoid then
		return nil
	end

	return character
end

--==================================================
-- LEER TAMAÑO
--==================================================

local function getSizeValue()
	local value = tonumber(sizeBox.Text)

	if not value then
		return nil
	end

	if value <= 0 then
		return nil
	end

	return value
end

--==================================================
-- ESPERAR VALOR DE ESCALA
--==================================================

local function waitForScaleValue(humanoid, name)
	local value = humanoid:FindFirstChild(name)

	if value then
		return value
	end

	local startTime = os.clock()

	while os.clock() - startTime < 5 do
		value = humanoid:FindFirstChild(name)

		if value then
			return value
		end

		task.wait(0.1)
	end

	return nil
end

--==================================================
-- PREPARAR ESCALA R15
--==================================================

local function prepareR15Scaling(humanoid)
	local bodyHeight = waitForScaleValue(humanoid, "BodyHeightScale")
	local bodyWidth = waitForScaleValue(humanoid, "BodyWidthScale")
	local bodyDepth = waitForScaleValue(humanoid, "BodyDepthScale")
	local headScale = waitForScaleValue(humanoid, "HeadScale")

	if not bodyHeight or not bodyWidth or not bodyDepth or not headScale then
		return false
	end

	originalR15Scales = {
		BodyHeightScale = bodyHeight.Value,
		BodyWidthScale = bodyWidth.Value,
		BodyDepthScale = bodyDepth.Value,
		HeadScale = headScale.Value
	}

	originalAutomaticScaling = humanoid.AutomaticScalingEnabled

	-- Necesario para que los valores de escala controlen el cuerpo.
	humanoid.AutomaticScalingEnabled = true

	return true
end

--==================================================
-- APLICAR ESCALA R15
--==================================================

local function applyR15Scale(multiplier)
	local character = currentCharacter

	if not character then
		return false
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return false
	end

	if not originalR15Scales then
		return false
	end

	local bodyHeight = humanoid:FindFirstChild("BodyHeightScale")
	local bodyWidth = humanoid:FindFirstChild("BodyWidthScale")
	local bodyDepth = humanoid:FindFirstChild("BodyDepthScale")
	local headScale = humanoid:FindFirstChild("HeadScale")

	if not bodyHeight or not bodyWidth or not bodyDepth or not headScale then
		return false
	end

	bodyHeight.Value = originalR15Scales.BodyHeightScale * multiplier
	bodyWidth.Value = originalR15Scales.BodyWidthScale * multiplier
	bodyDepth.Value = originalR15Scales.BodyDepthScale * multiplier
	headScale.Value = originalR15Scales.HeadScale * multiplier

	return true
end

--==================================================
-- RESTAURAR ESCALA R15
--==================================================

local function restoreR15Scale()
	local character = currentCharacter

	if not character then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return
	end

	if not originalR15Scales then
		return
	end

	local bodyHeight = humanoid:FindFirstChild("BodyHeightScale")
	local bodyWidth = humanoid:FindFirstChild("BodyWidthScale")
	local bodyDepth = humanoid:FindFirstChild("BodyDepthScale")
	local headScale = humanoid:FindFirstChild("HeadScale")

	if bodyHeight then
		bodyHeight.Value = originalR15Scales.BodyHeightScale
	end

	if bodyWidth then
		bodyWidth.Value = originalR15Scales.BodyWidthScale
	end

	if bodyDepth then
		bodyDepth.Value = originalR15Scales.BodyDepthScale
	end

	if headScale then
		headScale.Value = originalR15Scales.HeadScale
	end

	if originalAutomaticScaling ~= nil then
		humanoid.AutomaticScalingEnabled = originalAutomaticScaling
	end
end

--==================================================
-- PREPARAR PERSONAJE
--==================================================

local function prepareCharacter(character)
	if not character then
		return
	end

	currentCharacter = character
	isSizeOn = false

	sizeToggle.Text = "Size • Off"

	originalR15Scales = nil
	originalAutomaticScaling = nil

	task.wait(0.3)

	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		humanoid = character:WaitForChild("Humanoid", 5)
	end

	if not humanoid then
		return
	end

	--==================================================
	-- R15
	--==================================================

	if humanoid.RigType == Enum.HumanoidRigType.R15 then

		if prepareR15Scaling(humanoid) then
			scalingMode = "R15"
			normalScale = 1
			return
		end
	end

	--==================================================
	-- R6 / FALLBACK
	--==================================================

	scalingMode = "Model"

	local success, scale = pcall(function()
		return character:GetScale()
	end)

	if success and typeof(scale) == "number" and scale > 0 then
		normalScale = scale
	else
		normalScale = 1
	end
end

--==================================================
-- APLICAR TAMAÑO
--==================================================

local function applySize(enabled)
	local character = getCharacter()

	if not character then
		return
	end

	if currentCharacter ~= character then
		prepareCharacter(character)
	end

	--==================================================
	-- ACTIVAR
	--==================================================

	if enabled then

		local sizeValue = getSizeValue()

		if not sizeValue then
			sizeBox.Text = tostring(DEFAULT_SIZE)
			sizeValue = DEFAULT_SIZE
		end

		local success = false

		--==================================================
		-- R15
		--==================================================

		if scalingMode == "R15" then
			success = applyR15Scale(sizeValue)
		end

		--==================================================
		-- R6 / FALLBACK
		--==================================================

		if not success then

			scalingMode = "Model"

			pcall(function()

				-- Escala desde el pivote del personaje.
				-- Esto mantiene las partes y sus uniones centradas.

				character:ScaleTo(normalScale * sizeValue)

			end)

			success = true
		end

		if success then
			isSizeOn = true
			sizeToggle.Text = "Size • On"
		end

	--==================================================
	-- DESACTIVAR
	--==================================================

	else

		if scalingMode == "R15" then

			restoreR15Scale()

		else

			pcall(function()
				character:ScaleTo(normalScale)
			end)

		end

		isSizeOn = false
		sizeToggle.Text = "Size • Off"
	end
end

--==================================================
-- VALIDAR TEXTO
--==================================================

sizeBox.FocusLost:Connect(function()
	local value = tonumber(sizeBox.Text)

	if not value or value <= 0 then
		sizeBox.Text = tostring(DEFAULT_SIZE)
		return
	end

	if isSizeOn then
		applySize(true)
	end
end)

--==================================================
-- TOGGLE
--==================================================

sizeToggle.Activated:Connect(function()
	applySize(not isSizeOn)
end)

--==================================================
-- ABRIR / CERRAR GUI
--==================================================

button.Activated:Connect(function()
	panel.Visible = not panel.Visible
end)

